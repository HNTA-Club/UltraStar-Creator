{
  "configurations": [
    {
      "name": "Win32-MSVC",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/include/**",
        "${env:QTDIR}/include/**",
        "${env:QTDIR}/include/QtCore",
        "${env:QTDIR}/include/QtWidgets",
        "${env:QTDIR}/include/QtGui",
        "${env:QTDIR}/include/QtNetwork",
        "C:/Qt/**/msvc2022_64/include/**",
        "D:/Qt/**/msvc2022_64/include/**",
        "${workspaceFolder}/include/taglib",
        "${workspaceFolder}/include/cld2/**"
      ],
      "defines": [
        "UNICODE",
        "_UNICODE",
        "WIN32",
        "WIN64",
        "_ENABLE_EXTENDED_ALIGNED_STORAGE"
      ],
      "compilerPath": "cl.exe",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-msvc-x64"
    },
    {
      "name": "WSL-Linux",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/include/**",
        "/usr/include/x86_64-linux-gnu/qt6/**",
        "/usr/include/x86_64-linux-gnu/qt6/QtCore",
        "/usr/include/x86_64-linux-gnu/qt6/QtWidgets",
        "/usr/include/x86_64-linux-gnu/qt6/QtGui",
        "/usr/include/x86_64-linux-gnu/qt6/QtNetwork",
        "/usr/include/taglib",
        "/usr/include/cld2/**",
        "/usr/include/**"
      ],
      "defines": [],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
